@echo off
chcp 65001 >nul
cd /d "%~dp0"
title FishBot - калибровка звука

if not exist "FishBot.exe" (
    echo FishBot.exe не найден рядом с этим файлом: %~dp0
    pause
    exit /b 1
)

echo ============================================================
echo  Калибровка звука FishBot. Бот НИЧЕГО не нажимает.
echo.
echo  1. Переключитесь в игру и порыбачьте вручную 5-10 забросов.
echo  2. Смотрите сюда: "!" должен появляться на всплеске поплавка.
echo  3. Ctrl+C - закончить и увидеть статистику.
echo     Если спросит "Завершить выполнение пакетного файла" - N.
echo ============================================================
echo.

FishBot.exe --calibrate
